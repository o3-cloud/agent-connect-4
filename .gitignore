# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Build artifacts
/bin/
/dist/

# Workspace directories (for worktree pattern)
workspace/
prototype/

# Claude Code local state (shared config such as .claude/settings.json stays tracked)
.claude/*.lock
.claude/settings.local.json

# Pinned build tools (Tailwind CLI) and generated CSS (ADR-012)
.tools/
internal/web/static/app.css

# Loop worktrees (docs/specs/practices/loop-coordination.md rule 9)
.sdlc/worktree/
