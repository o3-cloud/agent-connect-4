{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .alp { display: flex; flex-direction: column; gap: var(--cds-gap-xl); font-family: var(--font-anthropic-sans); color: var(--color-fg); }\n  .alp h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .alp h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0 0 var(--cds-gap-sm); text-wrap: balance; }\n  .alp-sub { color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 0; }\n  .alp-take { font-size: var(--cds-font-size-heading); margin: var(--cds-gap-sm) 0 0; max-width: 70ch; }\n  .alp-verdict { display: inline-block; padding: 2px 10px; border-radius: 999px; font-weight: var(--cds-font-weight-medium); background: var(--color-panel); border: 1px solid var(--color-border-line); }\n  .alp-verdict.is-climbing { color: var(--color-ok); border-color: var(--color-ok); }\n  .alp-verdict.is-stalled { color: var(--color-warn); border-color: var(--color-warn); }\n  .alp-verdict.is-slipping { color: var(--color-bad); border-color: var(--color-bad); }\n  .alp-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--cds-gap-md); }\n  .alp-tile { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-xs); min-width: 0; }\n  .alp-tile .lab { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .alp-tile .num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 32px; line-height: 1.1; font-variant-numeric: tabular-nums; }\n  .alp-tile .chg { font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; color: var(--color-fg-muted); }\n  .alp-tile .chg.good { color: var(--color-ok); } .alp-tile .chg.bad { color: var(--color-bad); }\n  .alp-tile.attn { border-color: var(--color-warn); }\n  .alp-grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--cds-gap-lg); }\n  .alp-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); min-width: 0; }\n  .alp-note { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: var(--cds-gap-xs) 0 0; }\n  .alp-chart { position: relative; min-height: 210px; }\n  .alp-chart svg text { fill: var(--cds-text-secondary); font-size: var(--cds-font-size-caption); }\n  .alp-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); box-shadow: var(--cds-shadow-popover); border-radius: var(--cds-radius); padding: 6px 8px; font-size: var(--cds-font-size-caption); white-space: nowrap; z-index: 2; }\n  .alp-legend { display: flex; flex-wrap: wrap; gap: var(--cds-gap-md); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin-top: var(--cds-gap-xs); }\n  .alp-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }\n  .alp-wrap { overflow-x: auto; }\n  .alp table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-body); }\n  .alp th { text-align: left; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-weight: var(--cds-font-weight-medium); padding: 6px 8px; border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .alp td { padding: 8px; border-bottom: 1px solid var(--color-border-line); vertical-align: top; }\n  .alp tr:last-child td { border-bottom: 0; }\n  .alp td.n { font-variant-numeric: tabular-nums; white-space: nowrap; }\n  .alp-pill { display: inline-block; font-size: var(--cds-font-size-caption); padding: 1px 8px; border-radius: 999px; border: 1px solid var(--color-border-line); white-space: nowrap; }\n  .alp-pill.high { color: var(--color-bad); border-color: var(--color-bad); }\n  .alp-pill.medium { color: var(--color-warn); border-color: var(--color-warn); }\n  .alp-pill.ok { color: var(--color-ok); border-color: var(--color-ok); }\n  .alp-bar { position: relative; height: 8px; border-radius: 4px; background: var(--cds-chart-grid); min-width: 80px; margin-top: 6px; }\n  .alp-bar > span { position: absolute; inset: 0 auto 0 0; border-radius: 4px; }\n  .alp details > summary { cursor: pointer; font-weight: var(--cds-font-weight-medium); }\n  .alp-ref { font-family: ui-monospace, Menlo, monospace; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); word-break: break-word; }\n</style>\n\n<div class=\"alp\">\n  <header id=\"top\">\n    <h1>Arena Loop Progress</h1>\n    <p class=\"alp-sub\">Connect Four Arena: issues, behaviour contracts (BDRs), backlog and the decisions that need you. Updated by an hourly loop. Last run <span data-draw=\"lastRun\" data-source=\"latest\" data-field=\"at\" data-row=\"0\">\u2014</span>.</p>\n    <p class=\"alp-take\">Since the previous run: <span class=\"alp-verdict\" data-draw=\"verdict\" data-source=\"latest\" data-field=\"verdict\" data-row=\"0\">\u2014</span> <span data-draw=\"verdictWhy\">\u2014</span></p>\n  </header>\n\n  <section id=\"kpis\" class=\"alp-tiles\" aria-label=\"Headline numbers\">\n    <div class=\"alp-tile\"><span class=\"lab\">Open issues</span><span class=\"num\" data-draw=\"k-open\" data-source=\"latest\" data-field=\"issuesOpen\" data-row=\"0\">\u2014</span><span class=\"chg\" data-draw=\"d-open\">\u2014</span></div>\n    <div class=\"alp-tile\"><span class=\"lab\">Closed issues</span><span class=\"num\" data-draw=\"k-closed\" data-source=\"latest\" data-field=\"issuesClosed\" data-row=\"0\">\u2014</span><span class=\"chg\" data-draw=\"d-closed\">\u2014</span></div>\n    <div class=\"alp-tile\"><span class=\"lab\">BDRs accepted (of <span data-draw=\"k-bdrTotal\" data-source=\"latest\" data-field=\"bdrTotal\" data-row=\"0\">\u2014</span>)</span><span class=\"num\" data-draw=\"k-accepted\" data-source=\"latest\" data-field=\"bdrAccepted\" data-row=\"0\">\u2014</span><span class=\"chg\" data-draw=\"d-accepted\">\u2014</span></div>\n    <div class=\"alp-tile\"><span class=\"lab\">Acceptance criteria met (of <span data-draw=\"k-acTotal\" data-source=\"latest\" data-field=\"acTotal\" data-row=\"0\">\u2014</span>)</span><span class=\"num\" data-draw=\"k-ac\" data-source=\"latest\" data-field=\"acDone\" data-row=\"0\">\u2014</span><span class=\"chg\" data-draw=\"d-ac\">\u2014</span></div>\n    <div class=\"alp-tile\"><span class=\"lab\">Backlog items</span><span class=\"num\" data-draw=\"k-backlog\" data-source=\"latest\" data-field=\"backlogTotal\" data-row=\"0\">\u2014</span><span class=\"chg\" data-draw=\"d-backlog\">\u2014</span></div>\n    <div class=\"alp-tile attn\"><span class=\"lab\">Need your decision</span><span class=\"num\" data-draw=\"k-hitl\" data-source=\"hitlCount\">\u2014</span><span class=\"chg\">listed below</span></div>\n  </section>\n\n  <section id=\"needs-you\" class=\"alp-card\">\n    <h2>Needs a human</h2>\n    <div class=\"alp-wrap\">\n      <table data-source=\"hitl\" data-row-key=\"n\">\n        <thead><tr><th data-field=\"severity\">Priority</th><th data-field=\"item\">What</th><th data-field=\"ask\">Decision needed</th><th data-field=\"ref\">Where</th></tr></thead>\n        <tbody data-draw=\"hitlRows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"alp-grid2\">\n    <div class=\"alp-card\" id=\"issues-chart\">\n      <h2>Issues open and closed over time</h2>\n      <div class=\"alp-chart\" data-draw=\"issuesChart\" data-source=\"history\">\u2014</div>\n      <div class=\"alp-legend\"><span><i data-draw=\"sw0\"></i>Open</span><span><i data-draw=\"sw1\"></i>Closed</span></div>\n    </div>\n    <div class=\"alp-card\" id=\"progress-chart\">\n      <h2>Behaviour progress over time</h2>\n      <div class=\"alp-chart\" data-draw=\"progressChart\" data-source=\"history\">\u2014</div>\n      <div class=\"alp-legend\"><span><i data-draw=\"sw2\"></i>Acceptance criteria met</span><span><i data-draw=\"sw3\"></i>BDRs accepted</span><span><i data-draw=\"sw4\"></i>BDRs on main</span></div>\n    </div>\n  </section>\n\n  <section id=\"outcomes\" class=\"alp-card\">\n    <h2>Hill-climb by outcome</h2>\n    <p class=\"alp-note\">Each outcome from OUTCOMES.md, measured by the acceptance criteria of the BDRs that trace to it. A criterion counts as met when it is ticked on its tracking issue, or when its BDR is Accepted.</p>\n    <div class=\"alp-wrap\">\n      <table data-source=\"outcomes\" data-row-key=\"outcome\">\n        <thead><tr><th data-field=\"outcome\">#</th><th data-field=\"name\">Outcome</th><th data-field=\"acDone\">Criteria met</th><th>Progress</th><th data-field=\"bdrsSatisfied\">BDRs met</th><th data-source=\"outcomeTrend\" data-field=\"change\">Since last run</th><th data-field=\"backlogItems\">Backlog ideas</th></tr></thead>\n        <tbody data-draw=\"outcomeRows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"loops\" class=\"alp-card\">\n    <h2>Loops</h2>\n    <div class=\"alp-wrap\">\n      <table data-source=\"loops\" data-row-key=\"loop\">\n        <thead><tr><th data-field=\"loop\">Loop</th><th data-field=\"session\">Session</th><th data-field=\"status\">Status</th><th data-field=\"lastSeen\">Last active</th><th data-field=\"detail\">Output</th><th data-field=\"role\">Job</th><th data-field=\"cadence\">Cadence</th></tr></thead>\n        <tbody data-draw=\"loopRows\"></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"bdrs\" class=\"alp-card\">\n    <details>\n      <summary>All BDRs (<span data-draw=\"bdrCount\" data-source=\"latest\" data-field=\"bdrTotal\" data-row=\"0\">\u2014</span>)</summary>\n      <div class=\"alp-wrap\">\n        <table data-source=\"bdrs\" data-row-key=\"bdr\">\n          <thead><tr><th data-field=\"bdr\">BDR</th><th data-field=\"title\">Behaviour</th><th data-field=\"status\">Status</th><th data-field=\"issue\">Tracking issue</th><th data-field=\"acDone\">Criteria met</th><th data-field=\"acTotal\">Criteria</th><th data-field=\"outcomes\">Outcomes</th></tr></thead>\n          <tbody data-draw=\"bdrRows\"></tbody>\n        </table>\n      </div>\n    </details>\n  </section>\n\n  <section id=\"issues\" class=\"alp-card\">\n    <details>\n      <summary>All issues (<span data-draw=\"issueCount\" data-source=\"latest\" data-field=\"issuesTotal\" data-row=\"0\">\u2014</span>)</summary>\n      <div class=\"alp-wrap\">\n        <table data-source=\"issues\" data-row-key=\"id\">\n          <thead><tr><th data-field=\"status\">Status</th><th data-field=\"title\">Issue</th><th data-field=\"source\">Found by</th><th data-field=\"found\">Found</th><th data-field=\"closedApprox\">Closed (approx.)</th></tr></thead>\n          <tbody data-draw=\"issueRows\"></tbody>\n        </table>\n      </div>\n    </details>\n  </section>\n\n  <section id=\"backlog\" class=\"alp-card\">\n    <details>\n      <summary>Backlog (<span data-draw=\"backlogCount\" data-source=\"latest\" data-field=\"backlogTotal\" data-row=\"0\">\u2014</span>)</summary>\n      <div class=\"alp-wrap\">\n        <table data-source=\"backlog\" data-row-key=\"id\">\n          <thead><tr><th data-field=\"title\">Idea</th><th data-field=\"type\">Type</th><th data-field=\"outcomes\">Outcomes</th><th data-field=\"status\">Status</th><th data-field=\"created\">Created</th></tr></thead>\n          <tbody data-draw=\"backlogRows\"></tbody>\n        </table>\n      </div>\n    </details>\n  </section>\n</div>\n\n<script>\n  // Latest snapshot plus the change since the previous one, and a verdict.\n  dash.calc('latest', {\n    title: 'Latest snapshot vs previous',\n    description: 'The newest snapshot, its change from the one before, and whether progress moved.',\n    inputs: ['history'],\n    fn: (history) => {\n      const rows = history.slice().sort((a, b) => String(a.at).localeCompare(String(b.at)));\n      if (!rows.length) return [];\n      const cur = rows[rows.length - 1];\n      const prev = rows.length > 1 ? rows[rows.length - 2] : null;\n      const keys = ['issuesOpen', 'issuesClosed', 'bdrAccepted', 'bdrSatisfied', 'bdrOnMain', 'acDone', 'backlogTotal'];\n      const out = { ...cur, hasPrev: !!prev };\n      for (const k of keys) out['d_' + k] = prev ? (+cur[k]) - (+prev[k]) : null;\n      const progress = ['issuesClosed', 'bdrAccepted', 'bdrSatisfied', 'bdrOnMain', 'acDone'];\n      const moved = (a, b) => progress.some((k) => (+a[k]) !== (+b[k]));\n      const up = prev && progress.some((k) => (+cur[k]) > (+prev[k]));\n      const down = prev && progress.some((k) => (+cur[k]) < (+prev[k]));\n      let stalledRuns = 0;\n      for (let i = rows.length - 1; i > 0; i--) { if (moved(rows[i], rows[i - 1])) break; stalledRuns++; }\n      out.stalledRuns = stalledRuns;\n      out.verdict = !prev ? 'First snapshot' : down ? 'Slipping' : up ? 'Climbing' : 'Stalled';\n      return [out];\n    },\n  });\n  dash.calc('outcomeTrend', {\n    title: 'Outcome change since last run',\n    description: 'Change in acceptance criteria met for each outcome between the last two snapshots.',\n    inputs: ['outcomes', 'history'],\n    fn: (outcomes, history) => {\n      const rows = history.slice().sort((a, b) => String(a.at).localeCompare(String(b.at)));\n      const prev = rows.length > 1 ? rows[rows.length - 2] : null;\n      return outcomes.map((o) => ({ outcome: o.outcome, change: prev && prev['o' + o.outcome + 'Done'] != null ? (+o.acDone) - (+prev['o' + o.outcome + 'Done']) : null }));\n    },\n  });\n  dash.calc('hitlCount', {\n    title: 'Decisions needed',\n    description: 'Number of open items that need a human decision.',\n    inputs: ['hitl'],\n    fn: (hitl) => hitl.length,\n  });\n</script>\n\n<script>\n  window.alp = (() => {\n    const fmtTime = d3.timeFormat('%b %-d, %H:%M');\n    const signed = (v) => (v == null ? '' : v > 0 ? '+' + v : v < 0 ? '\u2212' + Math.abs(v) : '\u00b10');\n    const one = (id) => { const d = dash.data(id); return d.status === 'ok' && d.data && d.data.length ? d.data[0] : null; };\n    const pill = (text, cls) => { const s = document.createElement('span'); s.className = 'alp-pill ' + (cls || ''); s.textContent = text; return s; };\n    const td = (text, cls) => { const c = document.createElement('td'); if (cls) c.className = cls; if (text instanceof Node) c.append(text); else c.textContent = text == null || text === '' ? '\u2014' : String(text); return c; };\n\n    function tbody(el, id, key, cells) {\n      const d = dash.data(id);\n      el.replaceChildren();\n      if (d.status !== 'ok') {\n        const tr = document.createElement('tr');\n        tr.append(td(d.status === 'error' ? 'Failed to load' : 'Loading\u2026'));\n        el.append(tr);\n        return;\n      }\n      for (const r of d.data) {\n        const tr = document.createElement('tr');\n        tr.dataset.key = encodeURIComponent(String(r[key]));\n        for (const c of cells(r)) tr.append(c);\n        el.append(tr);\n      }\n    }\n\n    function lineChart(el, series, label) {\n      const d = dash.data('history');\n      el.replaceChildren();\n      if (d.status !== 'ok') { el.textContent = d.status === 'error' ? 'Failed to load' : '\u2014'; return; }\n      const rows = d.data.slice().sort((a, b) => String(a.at).localeCompare(String(b.at))).map((r) => ({ ...r, _t: new Date(r.at) }));\n      if (!rows.length) { el.textContent = 'No snapshots yet.'; return; }\n      const w = Math.max(260, el.clientWidth || 300), h = 200;\n      const ymax = Math.max(4, d3.max(rows, (r) => d3.max(series, (s) => +r[s.key])) || 0);\n      const y = d3.scaleLinear().domain([0, ymax]).nice().range([h - 26, 12]);\n      const svg = d3.select(el).append('svg').attr('viewBox', `0 0 ${w} ${h}`).attr('width', '100%').attr('role', 'img').attr('aria-label', label);\n      const yTicks = y.ticks(4).filter(Number.isInteger);\n      const probe = svg.append('g').selectAll('text').data(yTicks).join('text').text((t) => t);\n      const left = Math.ceil(d3.max(probe.nodes(), (n) => n.getComputedTextLength()) || 20) + 10;\n      probe.remove();\n      const t0 = rows[0]._t, t1 = rows[rows.length - 1]._t;\n      const span = rows.length > 1 ? [t0, t1] : [new Date(+t0 - 3600e3), new Date(+t0 + 3600e3)];\n      const endProbe = svg.append('g').selectAll('text').data(series).join('text').text((s) => String(rows[rows.length - 1][s.key]));\n      const right = Math.ceil(d3.max(endProbe.nodes(), (n) => n.getComputedTextLength()) || 16) + 14;\n      endProbe.remove();\n      const x = d3.scaleTime().domain(span).range([left, w - right]);\n      svg.append('g').selectAll('line').data(yTicks).join('line')\n        .attr('x1', left).attr('x2', w - right).attr('y1', (t) => y(t)).attr('y2', (t) => y(t)).style('stroke', 'var(--cds-chart-grid)');\n      svg.append('g').selectAll('text').data(yTicks).join('text')\n        .attr('x', left - 6).attr('y', (t) => y(t)).attr('dy', '0.32em').attr('text-anchor', 'end').text((t) => t);\n      const xt = rows.length > 1 ? x.ticks(Math.max(2, Math.floor(w / 140))) : [t0];\n      const xLabels = svg.append('g').selectAll('text').data(xt).join('text')\n        .attr('y', h - 6).attr('text-anchor', 'start').text((t) => d3.timeFormat(rows.length > 1 ? '%-d %b %H:%M' : '%b %-d, %H:%M')(t));\n      // Centre each label on its tick, but keep it inside the drawing and clear of its neighbour.\n      let prevEnd = -Infinity;\n      xLabels.each(function (t) {\n        const len = this.getComputedTextLength();\n        const at = Math.min(Math.max(2, x(t) - len / 2), w - 2 - len);\n        if (at < prevEnd + 8) { this.remove(); return; }\n        this.setAttribute('x', at);\n        prevEnd = at + len;\n      });\n      series.forEach((s, i) => {\n        const color = dash.colors[s.color ?? i];\n        const line = d3.line().x((r) => x(r._t)).y((r) => y(+r[s.key]));\n        if (rows.length > 1) svg.append('path').datum(rows).attr('d', line).style('fill', 'none').style('stroke', color).style('stroke-width', 2);\n        const last = rows[rows.length - 1];\n        svg.append('circle').attr('cx', x(last._t)).attr('cy', y(+last[s.key])).attr('r', 3.5).style('fill', color);\n        svg.append('text').attr('x', x(last._t) + 6).attr('y', y(+last[s.key])).attr('dy', '0.32em').text(+last[s.key]);\n      });\n      const tip = document.createElement('div');\n      tip.className = 'alp-tip'; tip.hidden = true; el.append(tip);\n      const guide = svg.append('line').attr('y1', 12).attr('y2', h - 26).style('stroke', 'var(--cds-chart-reference)').style('visibility', 'hidden');\n      svg.on('pointermove', (ev) => {\n        const [mx] = d3.pointer(ev);\n        const tx = x.invert(mx);\n        const r = rows.reduce((a, b) => (Math.abs(b._t - tx) < Math.abs(a._t - tx) ? b : a));\n        guide.attr('x1', x(r._t)).attr('x2', x(r._t)).style('visibility', 'visible');\n        tip.replaceChildren();\n        const head = document.createElement('div'); head.textContent = fmtTime(r._t); tip.append(head);\n        for (const s of series) { const l = document.createElement('div'); l.textContent = `${s.label}: ${r[s.key]}`; tip.append(l); }\n        tip.hidden = false;\n        const px = (x(r._t) / w) * el.clientWidth;\n        tip.style.left = Math.min(Math.max(0, px + 8), el.clientWidth - tip.offsetWidth) + 'px';\n        tip.style.top = '4px';\n      }).on('pointerleave', () => { tip.hidden = true; guide.style('visibility', 'hidden'); });\n    }\n    return { fmtTime, signed, one, pill, td, tbody, lineChart };\n  })();\n</script>\n\n<script>\n  const A = window.alp;\n\n  dash.draw('lastRun', (el) => { const r = A.one('latest'); el.textContent = r ? A.fmtTime(new Date(r.at)) : '\u2014'; });\n  dash.draw('verdict', (el) => {\n    const r = A.one('latest');\n    el.textContent = r ? r.verdict : '\u2014';\n    el.className = 'alp-verdict' + (r ? ' is-' + r.verdict.split(' ')[0].toLowerCase() : '');\n  });\n  dash.draw('verdictWhy', (el) => {\n    const r = A.one('latest');\n    if (!r) { el.textContent = '\u2014'; return; }\n    if (!r.hasPrev) { el.textContent = 'This is the baseline. The next hourly run compares against it.'; return; }\n    const bits = [];\n    if (r.d_acDone) bits.push(`${A.signed(r.d_acDone)} criteria met`);\n    if (r.d_issuesClosed) bits.push(`${A.signed(r.d_issuesClosed)} issues closed`);\n    if (r.d_bdrAccepted) bits.push(`${A.signed(r.d_bdrAccepted)} BDRs accepted`);\n    if (r.d_bdrOnMain) bits.push(`${A.signed(r.d_bdrOnMain)} BDRs on main`);\n    if (r.d_issuesOpen) bits.push(`${A.signed(r.d_issuesOpen)} open issues`);\n    el.textContent = bits.length ? bits.join(', ') + '.' : `No progress for ${r.stalledRuns} run${r.stalledRuns === 1 ? '' : 's'} in a row.`;\n  });\n\n  const tile = (name, field) => dash.draw(name, (el) => { const r = A.one('latest'); el.textContent = r ? String(r[field]) : '\u2014'; });\n  [['k-open', 'issuesOpen'], ['k-closed', 'issuesClosed'], ['k-bdrTotal', 'bdrTotal'], ['k-accepted', 'bdrAccepted'], ['k-acTotal', 'acTotal'], ['k-ac', 'acDone'], ['k-backlog', 'backlogTotal'], ['bdrCount', 'bdrTotal'], ['issueCount', 'issuesTotal'], ['backlogCount', 'backlogTotal']].forEach(([n, f]) => tile(n, f));\n  // goodWhenUp: whether a rise is good news for that metric.\n  const delta = (name, field, goodWhenUp) => dash.draw(name, (el) => {\n    const r = A.one('latest');\n    const v = r ? r['d_' + field] : null;\n    el.className = 'chg' + (v ? ((v > 0) === goodWhenUp ? ' good' : ' bad') : '');\n    el.textContent = !r ? '\u2014' : v == null ? 'baseline run' : `${A.signed(v)} since last run`;\n  });\n  delta('d-open', 'issuesOpen', false); delta('d-closed', 'issuesClosed', true); delta('d-accepted', 'bdrAccepted', true); delta('d-ac', 'acDone', true); delta('d-backlog', 'backlogTotal', true);\n  dash.draw('k-hitl', (el) => { const d = dash.data('hitlCount'); el.textContent = d.status === 'ok' ? String(d.data) : '\u2014'; });\n\n  ['sw0', 'sw1', 'sw2', 'sw3', 'sw4'].forEach((n, i) => dash.draw(n, (el) => { el.style.background = dash.colors[[0, 1, 0, 1, 2][i]]; }));\n  dash.draw('issuesChart', (el) => A.lineChart(el, [{ key: 'issuesOpen', label: 'Open', color: 0 }, { key: 'issuesClosed', label: 'Closed', color: 1 }], 'Open and closed issue counts at each hourly snapshot'));\n  dash.draw('progressChart', (el) => A.lineChart(el, [{ key: 'acDone', label: 'Criteria met', color: 0 }, { key: 'bdrAccepted', label: 'BDRs accepted', color: 1 }, { key: 'bdrOnMain', label: 'BDRs on main', color: 2 }], 'Acceptance criteria met, BDRs accepted and BDRs on main at each hourly snapshot'));\n\n  const sevOrder = { high: 0, medium: 1, low: 2 };\n  dash.draw('hitlRows', (el) => {\n    const d = dash.data('hitl');\n    if (d.status === 'ok') d.data.sort((a, b) => (sevOrder[a.severity] ?? 3) - (sevOrder[b.severity] ?? 3) || a.n - b.n);\n    A.tbody(el, 'hitl', 'n', (r) => [A.td(A.pill(r.severity, r.severity)), A.td(r.item), A.td(r.ask), A.td(r.ref, 'alp-ref')]);\n    if (d.status === 'ok' && !d.data.length) {\n      const tr = document.createElement('tr');\n      const c = A.td('Nothing needs a decision right now. Loops can raise one by adding needs: human to an issue.');\n      c.colSpan = 4;\n      tr.append(c);\n      el.append(tr);\n    }\n  });\n  dash.draw('outcomeRows', (el) => {\n    const t = dash.data('outcomeTrend');\n    const trend = new Map((t.status === 'ok' ? t.data : []).map((r) => [String(r.outcome), r.change]));\n    A.tbody(el, 'outcomes', 'outcome', (r) => {\n      const bar = document.createElement('div'); bar.className = 'alp-bar';\n      const fill = document.createElement('span'); fill.style.width = (r.acTotal ? (100 * r.acDone) / r.acTotal : 0) + '%'; fill.style.background = dash.colors[0];\n      bar.append(fill);\n      bar.setAttribute('role', 'img'); bar.setAttribute('aria-label', `${r.acDone} of ${r.acTotal} criteria met`);\n      const ch = trend.get(String(r.outcome));\n      return [A.td(r.outcome, 'n'), A.td(r.name), A.td(`${r.acDone} / ${r.acTotal}`, 'n'), A.td(bar), A.td(`${r.bdrsSatisfied} / ${r.bdrs}`, 'n'), A.td(ch == null ? 'baseline' : A.signed(ch), 'n'), A.td(r.backlogItems, 'n')];\n    });\n  });\n  const loopTone = { running: 'ok', stopped: 'high', 'not found': 'high', unknown: 'medium' };\n  dash.draw('loopRows', (el) => A.tbody(el, 'loops', 'loop', (r) => [A.td(r.loop), A.td(r.session, 'alp-ref'), A.td(A.pill(r.status, loopTone[r.status] || '')), A.td(r.lastSeen, 'n'), A.td(r.detail), A.td(r.role), A.td(r.cadence)]));\n  dash.draw('bdrRows', (el) => A.tbody(el, 'bdrs', 'bdr', (r) => [A.td(r.bdr, 'n'), A.td(r.title), A.td(A.pill(r.status, r.status === 'Accepted' ? 'ok' : '')), A.td(r.issue), A.td(r.acDone, 'n'), A.td(r.acTotal, 'n'), A.td(r.outcomes, 'n')]));\n  dash.draw('issueRows', (el) => {\n    const d = dash.data('issues');\n    if (d.status === 'ok') d.data.sort((a, b) => (a.status === b.status ? a.id.localeCompare(b.id) : a.status === 'open' ? -1 : 1));\n    A.tbody(el, 'issues', 'id', (r) => [A.td(A.pill(r.status, r.status === 'closed' ? 'ok' : '')), A.td(r.title), A.td(r.source), A.td(r.found, 'n'), A.td(r.closedApprox, 'n')]);\n  });\n  dash.draw('backlogRows', (el) => A.tbody(el, 'backlog', 'id', (r) => [A.td(r.title), A.td(r.type), A.td(r.outcomes, 'n'), A.td(r.status), A.td(r.created, 'n')]));\n</script>\n"}